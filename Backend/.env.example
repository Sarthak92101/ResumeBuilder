# MongoDB Connection
# Local development:
MONGO_URI=mongodb://127.0.0.1:27017/interview-master
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/interview-master

# JWT Configuration
JWT_SECRET=your_jwt_secret_key

# Google Generative AI
GOOGLE_API_KEY=your_google_api_key

# SMTP configuration for email reminders
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=InterviewIq <no-reply@example.com>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
# For production: FRONTEND_URL=https://your-vercel-url.vercel.app
