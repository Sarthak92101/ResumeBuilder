# MongoDB Connection
# Local development:
MONGO_URI=mongodb://127.0.0.1:27017/interview-master
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/interview-master

# JWT Configuration
JWT_SECRET=your_jwt_secret_key

# OpenAI API for SAVIK interview replies
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none

# Google Generative AI for the other AI features
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-3.8-flash
# Per-user protection for Gemini-powered routes (SAVIK's OpenAI turns are excluded)
GEMINI_USER_DAILY_LIMIT=20
GEMINI_USER_COOLDOWN_MS=10000

# GitHub API (optional) — authenticates GitHub profile fetching and raises the rate
# limit from 60 to 5000 requests/hour. Integration works fine without it.
GITHUB_TOKEN=your_github_token

# SMTP configuration for email reminders
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=SkillMirror <no-reply@example.com>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
# For production: FRONTEND_URL=https://your-vercel-url.vercel.app

# Optional: absolute path to Tectonic for LaTeX resume PDF generation
# Defaults to "tectonic" resolved from PATH
# TECTONIC_BIN=/opt/homebrew/bin/tectonic
